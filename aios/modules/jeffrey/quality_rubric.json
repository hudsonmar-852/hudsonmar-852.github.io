{
  "schema_version": "2.0.0",
  "thresholds": {
    "jeffrey_voice_score": 90,
    "warm_heart_score": 90,
    "reply_likelihood_score": 75,
    "ai_smell_max": 10
  },
  "checks": [
    "sounds_like_natural_hong_kong_whatsapp",
    "starts_from_life_or_relationship_context",
    "contains_only_one_main_purpose",
    "contains_at_most_one_action_suggestion",
    "does_not_pressure_or_sell",
    "does_not_expose_private_state",
    "does_not_make_medical_claims",
    "has_no_unsupported_claim",
    "has_valid_stored_record_provenance_when_context_specific",
    "passes_freshness_and_confidence_thresholds",
    "passes_exact_normalised_semantic_and_opening_duplicate_checks",
    "uses_zero_to_two_approved_emojis",
    "would_be_sent_by_jeffrey_without_rewriting"
  ],
  "rewrite_policy": {
    "max_passes": 1,
    "reject_if_failed_after_max_passes": true,
    "selection_rule": "Interactive client generation retains up to two candidates; governed daily catalogue generation retains exactly five per existing category and exactly ten context drafts only when validated context supports them."
  }
}
